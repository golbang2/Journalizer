# Default OCR for both receipt images and single-page PDFs.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/vision-service-account.json
RECEIPT_OCR_ENGINE=vision
RECEIPT_VISION_FALLBACK=none

# Optional: explicit Claude OCR or fallback; not required by the default path.
# RECEIPT_OCR_ENGINE=claude
# ANTHROPIC_API_KEY=your-local-key
# CLAUDE_RECEIPT_MODEL=claude-haiku-5-5
# RECEIPT_VISION_FALLBACK=claude
# RECEIPT_PDF_ENGINE=claude  # Optional PDF-only override.

# Database. Unset = SQLite file at backend/data/app.db (local development).
# Production: PostgreSQL, e.g. postgresql+psycopg://journalizer:password@localhost:5432/journalizer
# DATABASE_URL=

# Session cookie over HTTPS only (set to true when deployed behind https).
# COOKIE_SECURE=true

# Optional Google sign-in (Google Cloud Console > OAuth client, type "Web application").
# Authorized redirect URI must match GOOGLE_REDIRECT_URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
